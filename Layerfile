# 基础镜像
FROM vm/ubuntu:18.04

# 安装 Docker
RUN apt-get update && \
    apt-get install -y ca-certificates curl gnupg lsb-release && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    echo \
    "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | \
    tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && \
    apt-get install -y docker-ce docker-ce-cli containerd.io

# 复制项目文件
COPY . .

# 设置环境变量
SECRET ENV UPTIME_KUMA_DB_NAME
SECRET ENV UPTIME_KUMA_DB_HOSTNAME
SECRET ENV UPTIME_KUMA_DB_USERNAME
SECRET ENV UPTIME_KUMA_DB_TYPE
SECRET ENV UPTIME_KUMA_DB_PORT
SECRET ENV UPTIME_KUMA_DB_PASSWORD

# 构建 Docker 镜像
RUN docker build -t uptime-kuma .

# 在后台运行 Docker 容器
   RUN BACKGROUND docker run -d -p 3001:3001 \
       -e UPTIME_KUMA_DB_NAME=$UPTIME_KUMA_DB_NAME \
       -e UPTIME_KUMA_DB_HOSTNAME=$UPTIME_KUMA_DB_HOSTNAME \
       -e UPTIME_KUMA_DB_USERNAME=$UPTIME_KUMA_DB_USERNAME \
       -e UPTIME_KUMA_DB_TYPE=$UPTIME_KUMA_DB_TYPE \
       -e UPTIME_KUMA_DB_PORT=$UPTIME_KUMA_DB_PORT \
       -e UPTIME_KUMA_DB_PASSWORD=$UPTIME_KUMA_DB_PASSWORD \
       uptime-kuma

# 暴露网站
EXPOSE WEBSITE http://localhost:3001
